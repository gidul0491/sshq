#!/usr/bin/env node
// SSH 원격 작업: 조회는 바로, 수정은 서버 안에 백업한 뒤
// 접속정보·라이브러리는 이 스크립트가 있는 폴더 기준 (sshq.json, node_modules, work/)
const fs = require('fs');
const os = require('os');
const zlib = require('zlib');
const path = require('path');
const { spawn, spawnSync, execSync } = require('child_process');

const DIR = path.dirname(fs.realpathSync(__filename));
const LIB = path.join(DIR, 'node_modules');
const FILE = path.join(DIR, 'sshq.json');
const WORK = path.join(DIR, 'work');
const BACKUP = path.join(DIR, 'backup');
const LOG = path.join(DIR, 'log');
const MAX_LINES = 2000;
// 원격 백업과 지울 파일은 웹에서 열리지 않도록 홈의 이 폴더들 아래에 원래 경로 그대로 둔다 (권한 700)
const BAK_DIR = '_sshq_backup';
const DEL_DIR = '_sshq_to_delete';
// 폴더 put 한 번(묶음)에 무엇을 바꾸고 새로 만들었는지 적어 두는 곳 (restore --batch용)
const BATCH_DIR = `${BAK_DIR}/.batches`;
const EDITABLE = ['root', 'projects', 'desc', 'mode'];
const MODES = ['', 'readonly']; // readonly: put·restore·del·exec·sudo 거부
// sudo가 비밀번호를 물을 때만 보내려고 프롬프트를 이 표시로 바꿔 알아본다
const SUDO_PROMPT = 'sshq_sudo_prompt:';
// sudo-allow·sudo-remove에서 모든 서버를 뜻하는 인자와, 전체 서버 설정을 담는 sshq.json 키
const ALL_SERVERS = '--all';
const GLOBAL_KEY = '_global';
// 승인 없이 sudo 목록이 늘어나지 않도록 sudo-allow는 Claude Code의 ask 규칙이 있어야 실행한다
const SUDO_ALLOW_RULES = process.platform === 'win32'
  ? ['Bash(sshq sudo-allow *)', 'PowerShell(sshq sudo-allow *)']
  : ['Bash(sshq sudo-allow *)'];

const fail = (msg, code = 1) => { console.error(msg); process.exit(code); };
if (Number(process.versions.node.split('.')[0]) < 22) fail(`Node 22 이상이 필요합니다. (현재: ${process.version})`);

const USAGE = `사용법:
  sshq                                   별칭 목록 (현재 프로젝트를 쓰는 별칭에 *)
  sshq <별칭> "<명령>"                    조회 명령 실행 (ls, cat, grep, tail, find ...)
  sshq ls <별칭> [원격경로]               폴더 목록 (명령 실행이 막힌 SFTP 전용 서버에서도 됨)
  sshq get <별칭> <원격경로>              원격 파일·폴더를 work/<별칭>/ 아래로 내려받기
  sshq diff <별칭> <원격경로> [로컬경로]   원격과 로컬 사본 비교 (폴더면 바뀐 파일 목록)
  sshq put <별칭> <원격경로> [로컬경로]    원격을 ~/${BAK_DIR}/ 아래에 백업한 뒤 업로드 (폴더면 바뀐 파일만 묶음으로)
  sshq restore <별칭> <원격경로> [백업]    백업으로 되돌리기 (생략 시 가장 최근 백업)
  sshq restore <별칭> --batch [묶음]       폴더 put 묶음 전체 되돌리기 (생략 시 묶음 목록)
  sshq log <별칭> [줄수]                  서버를 바꾼 작업 기록 보기 (기본 50줄)
  sshq del <별칭> <원격경로>              지우지 않고 ~/${DEL_DIR}/ 아래로 옮기기
  sshq clean <별칭> [원격경로]            work/<별칭>/의 로컬 사본 지우기 (생략 시 전부)
  sshq backup <별칭> [원격폴더]           폴더를 backup/<별칭>/에 tar.gz로 받기 (생략 시 홈 전체)
  sshq exec <별칭> "<명령>"               제한 없는 명령 실행 (사용자 승인 필요)
  sshq sudo <별칭> "<명령>"               승인된 명령을 sudo로 실행
  sshq sudo-allow <별칭|--all> "<명령>"   sudo로 쓸 명령 승인, --all은 모든 서버 (사용자 승인 필요)
  sshq sudo-remove <별칭|--all> "<명령>"  승인된 sudo 명령 빼기
  sshq set <별칭> <root|projects|desc|mode> <값>   수정, 빈 값("")이면 비우기 (mode는 readonly 또는 "")
  sshq new <별칭> [root] [설명]           새 서버 양식 추가 (접속정보는 빈칸)
  sshq version                           설치된 버전과 새 버전 확인
  sshq update                            새 버전으로 업데이트`;

const CMDS = ['ls', 'get', 'diff', 'put', 'restore', 'del', 'clean', 'backup', 'log', 'exec', 'sudo', 'sudo-allow', 'sudo-remove', 'set', 'new', 'version', 'update', 'help'];
const argv = process.argv.slice(2);
if (argv[0] === 'help' || argv[0] === '-h' || argv[0] === '--help') { console.log(USAGE); process.exit(0); }

let all;
try {
  all = JSON.parse(fs.readFileSync(FILE, 'utf8'));
} catch (e) {
  fail(`sshq.json 오류: ${e.message}`);
}
// all에는 서버 별칭만 남긴다. 전체 서버 설정은 저장할 때 다시 합친다
const globalSettings = { sudo: [], ...all[GLOBAL_KEY] };
delete all[GLOBAL_KEY];
// 빠진 항목만 빈칸으로 채운다 (있는 값은 그대로). 다음 저장 때 파일에도 반영된다
for (const c of Object.values(all)) {
  c.root ??= '';
  c.projects ??= [];
  c.desc ??= '';
  c.mode ??= '';
  c.sudo ??= [];
}
const save = () => fs.writeFileSync(FILE, JSON.stringify({ [GLOBAL_KEY]: globalSettings, ...all }, null, 2) + '\n', { mode: 0o600 });

// ---------- 조회 명령 검사 ----------
// 파이프로 이은 각 명령이 읽기 전용 목록에 있어야 하고, 쓰기·연결·치환 기호는 막는다
const READ = new Set([
  'ls', 'cat', 'head', 'tail', 'grep', 'egrep', 'fgrep', 'find', 'pwd', 'whoami', 'id', 'uname', 'hostname',
  'df', 'du', 'ps', 'uptime', 'free', 'stat', 'wc', 'file', 'which', 'date', 'md5sum', 'sha1sum', 'sha256sum',
  'diff', 'sort', 'uniq', 'cut', 'tr', 'echo', 'readlink', 'realpath', 'basename', 'dirname', 'zcat', 'tree',
  'php', 'tar', 'crontab', 'git', 'nl', 'column', 'test',
  'pm2', 'node', 'npm', 'java', 'systemctl', 'journalctl', 'ss', 'netstat', 'jq',
]);
// nvm 등으로 설치돼 로그인 셸에서만 경로가 잡히는 명령. 이 명령이 들어간 조회는 bash -lc 로 실행한다
const LOGIN_SHELL_COMMANDS = new Set(['pm2', 'node', 'npm', 'java']);
// pm2 jlist·describe·env 는 프로세스 환경변수(키·접속정보)를 출력해서 뺀다. logs 는 --nostream 이 있어야 끝난다
const PM2_READ = /^(list|ls|l|status)$/;
const usesLoginShell = (cmd) => (splitPipes(cmd) || []).some((seg) => LOGIN_SHELL_COMMANDS.has(seg.trim().split(/\s+/)[0]));
// 따옴표 밖의 | 로 나눈다. 따옴표 밖의 ; & > < 줄바꿈, 작은따옴표 밖의 ` $( 는 거부한다
function splitPipes(s) {
  const segs = [];
  let cur = '';
  let quote = '';
  for (let i = 0; i < s.length; i++) {
    const ch = s[i];
    if (quote !== "'" && (ch === '`' || (ch === '$' && s[i + 1] === '('))) return null;
    if (quote) {
      if (ch === quote) quote = '';
      else if (ch === '\\' && quote === '"') { cur += ch + (s[i + 1] || ''); i++; continue; }
      cur += ch;
      continue;
    }
    if (ch === "'" || ch === '"') { quote = ch; cur += ch; continue; }
    if (ch === '\\') { cur += ch + (s[i + 1] || ''); i++; continue; }
    if (/[;&><\n]/.test(ch)) return null;
    if (ch === '|') { if (s[i + 1] === '|') return null; segs.push(cur); cur = ''; continue; }
    cur += ch;
  }
  if (quote) return null;
  segs.push(cur);
  return segs;
}
function checkRead(cmd) {
  const s = cmd.replace(/\s2>\s*\/dev\/null(?=\s|$|\|)/g, ' ').replace(/\s2>&1(?=\s|$|\|)/g, ' ');
  const segs = splitPipes(s);
  if (!segs) return '조회 명령에는 따옴표 밖의 ; & && || > < 와 ` $( 를 쓸 수 없습니다. 수정은 put, 그 밖의 명령은 exec를 쓰세요.';
  for (const seg of segs) {
    const t = seg.trim().split(/\s+/);
    const [c, a1 = ''] = t;
    const rest = t.slice(1).join(' ');
    if (!c) return '빈 명령이 있습니다.';
    if (!READ.has(c)) return `조회 명령이 아닙니다: ${c} (허용: ${[...READ].join(', ')})`;
    if (c === 'php' && !/^(-v|--version|-l|-m|-i|--ini)$/.test(a1)) return 'php는 -v, -l, -m, -i, --ini만 쓸 수 있습니다.';
    if (c === 'tar' && !(/^--list$/.test(a1) || (/^-?[a-zA-Z]*t[a-zA-Z]*$/.test(a1) && !/[cxruA]/.test(a1)))) return 'tar는 목록 보기(t)만 쓸 수 있습니다.';
    if (c === 'crontab' && rest !== '-l') return 'crontab은 -l만 쓸 수 있습니다.';
    if (c === 'git' && !/^(status|log|diff|show|branch|remote|rev-parse|blame|ls-files)$/.test(a1)) return 'git은 조회 하위 명령만 쓸 수 있습니다.';
    if (c === 'find' && /\s-(exec|execdir|delete|ok|okdir|fprint0?|fprintf|fls)\b/.test(' ' + rest)) return 'find에서 -exec, -delete 등은 쓸 수 없습니다.';
    if (c === 'sort' && /(^|\s)(-o|--output)/.test(rest)) return 'sort -o는 쓸 수 없습니다.';
    if (c === 'pm2' && !(PM2_READ.test(a1) || (a1 === 'logs' && /(^|\s)--nostream(\s|$)/.test(rest)))) return 'pm2는 list, ls, status, logs --nostream만 쓸 수 있습니다.';
    if ((c === 'node' || c === 'npm') && !/^(-v|--version)$/.test(rest)) return `${c}는 -v만 쓸 수 있습니다.`;
    if (c === 'java' && !/^(-version|--version)$/.test(rest)) return 'java는 -version만 쓸 수 있습니다.';
    if (c === 'systemctl' && !/^(status|is-active|is-enabled|is-failed|list-units|list-timers|list-unit-files)$/.test(a1)) return 'systemctl은 status, is-active, list-units, list-timers 등 조회만 쓸 수 있습니다.';
    if (c === 'journalctl' && /(^|\s)(-f|--follow|--vacuum\S*|--rotate|--flush|--sync|--relinquish-var|--setup-keys)(\s|$)/.test(rest)) return 'journalctl은 -f, --vacuum 등 없이 조회만 쓸 수 있습니다.';
    if (c === 'ss' && /(^|\s)(-K|--kill)(\s|$)|(^|\s)-[a-zA-Z]*K/.test(rest)) return 'ss -K는 쓸 수 없습니다.';
    if (/\.env(?!\.example)\b/.test(rest)) return '.env 파일은 볼 수 없습니다 (.env.example만 됩니다).';
  }
  return '';
}

// 맨 앞 명령은 이 서버나 전체 서버 승인 목록의 단어들로 시작해야 하고(pm2 restart는 pm2 restart app까지 허용), 파이프 뒤는 조회 명령만 된다
function checkSudo(alias, server, cmd) {
  const pipeSegments = splitPipes(cmd);
  if (!pipeSegments) return 'sudo 명령에는 따옴표 밖의 ; & && || > < 와 ` $( 를 쓸 수 없습니다.';
  const sudoCommand = pipeSegments[0].trim();
  const commandWords = sudoCommand.split(/\s+/);
  const approvedCommands = [...server.sudo, ...globalSettings.sudo];
  const approved = approvedCommands.some((entry) => entry.split(' ').every((word, index) => word === commandWords[index]));
  if (!approved) return `승인되지 않은 sudo 명령입니다: ${sudoCommand} (승인된 명령: ${approvedCommands.join(', ') || '없음'})\n승인 요청: sshq sudo-allow ${alias} "<명령>"`;
  return pipeSegments.length > 1 ? checkRead(pipeSegments.slice(1).join('|')) : '';
}

// ---------- 공통 ----------
const q = (s) => `'${String(s).replace(/'/g, `'\\''`)}'`;
const ts = () => {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
};
const WIN = process.platform === 'win32';
const home = (p) => (p && /^~[/\\]/.test(p) ? path.join(os.homedir(), p.slice(2)) : p);
// 로컬경로 인자: ~/는 홈 기준, 윈도우에서 Git Bash 형식(/c/...)은 C:/...로
const localArg = (p) => path.resolve(WIN ? home(p).replace(/^\/([a-zA-Z])(?=\/|$)/, '$1:') : home(p));

// write: 서버를 바꾸는 명령(put·restore·del·exec·sudo). readonly 별칭이면 거부한다
function conf(alias, write) {
  if (!alias) fail(USAGE);
  const c = all[alias];
  if (!c) fail(`별칭 없음: ${alias} (있는 별칭: ${Object.keys(all).join(', ')})`);
  if (!c.host || !c.user) fail(`접속정보 미입력: ${alias} (${FILE})`);
  if (write && c.mode === 'readonly') fail(`읽기 전용 서버입니다: ${alias} (풀려면 sshq set ${alias} mode "")`);
  return c;
}

// 서버를 바꾼 작업을 log/<별칭>.log에 남긴다 (시각, 작업, 내용)
function logAct(alias, act, detail) {
  fs.mkdirSync(LOG, { recursive: true, mode: 0o700 });
  const now = new Date().toLocaleString('sv-SE');
  fs.appendFileSync(path.join(LOG, `${alias}.log`), `${now}\t${act}\t${detail}\n`, { mode: 0o600 });
}

// 원격 경로: 절대경로는 그대로, ~/는 홈 기준, 나머지는 root 기준(root가 없으면 홈 기준)
function remotePath(c, p) {
  if (!p) fail('원격경로를 입력하세요.');
  if (p.startsWith('/')) return path.posix.normalize(p);
  if (p.startsWith('~/')) return path.posix.normalize(p.slice(2));
  return path.posix.normalize(c.root ? path.posix.join(c.root, p) : p);
}
function localPath(alias, rp) {
  const lp = path.join(WORK, alias, rp.replace(/^\/+/, ''));
  if (!lp.startsWith(path.join(WORK, alias) + path.sep)) fail(`잘못된 경로: ${rp}`);
  return lp;
}

function connect(alias, c) {
  const { Client } = require(path.join(LIB, 'ssh2'));
  const opt = {
    host: c.host,
    port: Number(c.port) || 22,
    username: c.user,
    readyTimeout: 20000,
    tryKeyboard: true,
    hostHash: 'sha256',
    hostVerifier: (fp) => {
      if (!c.hostkey) {
        all[alias].hostkey = fp;
        save();
        console.error(`(처음 접속: 서버 지문을 저장했습니다 ${fp.slice(0, 16)}...)`);
        return true;
      }
      if (c.hostkey !== fp) {
        console.error(`서버 지문이 저장된 값과 다릅니다. 서버가 바뀌었거나 중간자 공격일 수 있어 접속을 중단합니다.\n저장값: ${c.hostkey}\n현재값: ${fp}\n서버 교체가 확실하면 사용자가 sshq.json의 hostkey를 지우고 다시 실행합니다.`);
        return false;
      }
      return true;
    },
  };
  if (c.key) {
    try { opt.privateKey = fs.readFileSync(home(c.key)); } catch (e) { fail(`키 파일을 읽을 수 없습니다: ${c.key}`); }
    if (c.passphrase) opt.passphrase = c.passphrase;
  }
  if (c.password) opt.password = c.password;
  // 윈도우 OpenSSH의 ssh-agent는 소켓 대신 named pipe를 쓴다
  if (!c.key && !c.password) opt.agent = process.env.SSH_AUTH_SOCK || (WIN ? '\\\\.\\pipe\\openssh-ssh-agent' : undefined);
  return new Promise((resolve, reject) => {
    const conn = new Client();
    conn.on('keyboard-interactive', (_n, _i, _l, prompts, finish) => finish(prompts.map(() => c.password || '')));
    conn.on('ready', () => resolve(conn));
    conn.on('error', reject);
    conn.connect(opt);
  });
}

// sudo가 비밀번호를 물으면 sudoPassword를 한 번만 보내고 입력을 닫는다 (틀려도 다시 시도하지 않음)
function run(conn, cmd, sudoPassword = '') {
  return new Promise((resolve, reject) => {
    conn.exec(cmd, (err, stream) => {
      if (err) return reject(err);
      let out = '';
      let errOut = '';
      let sudoAnswered = false;
      stream.on('data', (d) => { out += d; });
      stream.stderr.on('data', (d) => {
        errOut += d;
        if (sudoAnswered || !errOut.includes(SUDO_PROMPT)) return;
        sudoAnswered = true;
        stream.end(sudoPassword ? `${sudoPassword}\n` : undefined);
      });
      stream.on('close', (code) => resolve({ code: code ?? 0, out, err: errOut.replaceAll(SUDO_PROMPT, '') }));
    });
  });
}

const sftpOf = (conn) => new Promise((res, rej) => conn.sftp((e, s) => (e ? rej(e) : res(s))));
const pcall = (fn) => new Promise((res, rej) => fn((e, v) => (e ? rej(e) : res(v))));
const exists = (sftp, p) => pcall((cb) => sftp.stat(p, cb)).then((st) => st, () => null);
const download = (sftp, rp, lp) => pcall((cb) => sftp.fastGet(rp, lp, cb)).catch((e) => {
  throw new Error(`원격 파일을 받을 수 없습니다: ${rp} (${e.message})`);
});
// mode를 주면 새로 만드는 폴더와 홈 기준 맨 위 폴더(이미 있어도)에 그 권한을 준다
async function mkdirp(sftp, dir, mode) {
  const parts = dir.split('/');
  let cur = dir.startsWith('/') ? '' : '.';
  for (const part of parts) {
    if (!part || part === '.') continue;
    cur = cur === '.' ? part : `${cur}/${part}`;
    if (!(await exists(sftp, cur))) await pcall((cb) => sftp.mkdir(cur, mode ? { mode } : {}, cb));
  }
  const top = parts.find((x) => x && x !== '.');
  if (mode && top && !dir.startsWith('/')) await pcall((cb) => sftp.chmod(top, mode, cb));
}

function printOut(out) {
  const lines = out.replace(/\n$/, '').split('\n');
  if (out === '') return;
  console.log(lines.slice(0, MAX_LINES).join('\n'));
  if (lines.length > MAX_LINES) console.log(`(${lines.length}줄 중 ${MAX_LINES}줄 표시. head, grep으로 범위를 줄이세요)`);
}

const withCd = (c, cmd) => (c.root ? `cd ${q(c.root)} && ${cmd}` : cmd);

// SFTP 전용 계정(셸 거부)인지 확인한다. 거부 문구는 서버마다 달라서 짧은 명령의 결과로 판단한다
const shellOk = async (conn) => (await run(conn, 'echo sshq_ok').catch(() => ({ out: '' }))).out.trim() === 'sshq_ok';
const NO_SHELL = '명령 실행이 막힌 서버입니다 (SFTP만 됨). 목록은 sshq ls, 파일은 get·diff·put·restore·del·backup을 쓰세요.';

// ---------- 명령 ----------
// runKind: read(조회 명령만), exec(제한 없음), sudo(승인된 명령만)
async function cmdRun(alias, cmd, runKind) {
  const c = conf(alias, runKind !== 'read');
  if (!cmd) fail(USAGE);
  const why = runKind === 'read' ? checkRead(cmd) : runKind === 'sudo' ? checkSudo(alias, c, cmd) : '';
  if (why) fail(why);
  const conn = await connect(alias, c);
  try {
    const r = runKind === 'sudo'
      ? await run(conn, withCd(c, `sudo -S -p ${q(SUDO_PROMPT)} ${cmd}`), c.password)
      : await run(conn, withCd(c, usesLoginShell(cmd) ? `bash -lc ${q(cmd)}` : cmd));
    if (r.code !== 0 && !(await shellOk(conn))) fail(NO_SHELL);
    printOut(r.out);
    if (r.err) process.stderr.write(r.err);
    process.exitCode = r.code;
    if (runKind !== 'read') logAct(alias, runKind, `${cmd} (종료 코드 ${r.code})`);
  } finally {
    conn.end();
  }
}

// 폴더: 서버에서 tar로 묶어 한 번에 받고, tar를 못 쓰는 서버(SFTP 전용)는 파일마다 받는다
function getDirTar(conn, rp, lp) {
  return new Promise((resolve) => {
    conn.exec(`tar czf - -C ${q(rp)} .`, (err, stream) => {
      if (err) return resolve(false);
      // -C 대신 cwd: Git Bash의 GNU tar는 -C C:\...의 C:를 원격 호스트로 읽는다
      const x = spawn('tar', ['xzf', '-'], { cwd: lp, stdio: ['pipe', 'ignore', 'ignore'] });
      x.on('error', () => { stream.close(); resolve(false); });
      x.stdin.on('error', () => {});
      let warn = '';
      stream.stderr.on('data', (d) => { warn += d; });
      stream.pipe(x.stdin);
      const remote = new Promise((r) => stream.on('close', r));
      const local = new Promise((r) => x.on('close', r));
      Promise.all([remote, local]).then(([, code]) => {
        if (code === 0 && warn) process.stderr.write(warn);
        resolve(code === 0);
      });
    });
  });
}
// 파일마다 SFTP로 받는다 (권한·수정 시각 유지). skip: 받지 않을 맨 위 이름. 받은 파일 수와 못 받은 파일 수를 돌려준다
async function getDirSftp(sftp, rp, lp, skip = []) {
  const n = { ok: 0, fail: 0 };
  for (const e of await pcall((cb) => sftp.readdir(rp, cb))) {
    if (skip.includes(e.filename)) continue;
    const r = `${rp}/${e.filename}`;
    const l = path.join(lp, e.filename);
    if (e.attrs.isDirectory()) {
      fs.mkdirSync(l, { recursive: true });
      const s = await getDirSftp(sftp, r, l);
      n.ok += s.ok;
      n.fail += s.fail;
    } else if (e.attrs.isFile()) {
      try {
        await download(sftp, r, l);
        fs.chmodSync(l, e.attrs.mode & 0o777);
        fs.utimesSync(l, e.attrs.atime, e.attrs.mtime);
        n.ok++;
      } catch (er) {
        console.error(`건너뜀: ${er.message}`);
        n.fail++;
      }
    }
  }
  return n;
}

// SFTP로 폴더 목록을 본다 (셸이 막힌 서버에서도 됨)
async function cmdLs(alias, p) {
  const c = conf(alias);
  const rp = p ? remotePath(c, p) : c.root || '.';
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    const list = await pcall((cb) => sftp.readdir(rp, cb)).catch((e) => fail(`목록을 볼 수 없습니다: ${rp} (${e.message})`));
    const day = (t) => new Date(t * 1000).toLocaleString('sv-SE').slice(0, 16);
    const rows = list
      .sort((a, b) => a.filename.localeCompare(b.filename))
      .map((e) => {
        const d = e.attrs.isDirectory();
        return `${d ? 'd' : '-'} ${(e.attrs.mode & 0o777).toString(8)} ${String(e.attrs.size).padStart(10)} ${day(e.attrs.mtime)} ${e.filename}${d ? '/' : ''}`;
      });
    printOut(rows.join('\n') + '\n');
  } finally {
    conn.end();
  }
}

async function cmdGet(alias, p) {
  const c = conf(alias);
  const rp = remotePath(c, p);
  const lp = localPath(alias, rp);
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    const st = await exists(sftp, rp);
    if (!st) fail(`원격 파일 없음: ${rp}`);
    if (st.isDirectory()) {
      fs.mkdirSync(lp, { recursive: true });
      if (!(await shellOk(conn)) || !(await getDirTar(conn, rp, lp))) await getDirSftp(sftp, rp, lp);
      const n = fs.readdirSync(lp, { recursive: true, withFileTypes: true }).filter((d) => d.isFile()).length;
      console.log(`${rp}/ → ${lp}/ (파일 ${n}개)`);
      return;
    }
    fs.mkdirSync(path.dirname(lp), { recursive: true });
    await download(sftp, rp, lp);
    console.log(`${rp} → ${lp}`);
  } finally {
    conn.end();
  }
}

// 로컬 폴더의 파일을 원격 같은 경로와 비교한다 (OS가 만드는 파일 제외). 크기가 같으면 내용까지 비교
// 원격에만 있는 파일은 보지 않는다 (지우지 않음)
const LOCAL_JUNK = ['.DS_Store', 'Thumbs.db', 'desktop.ini'];
async function compareDir(sftp, lp, rp) {
  const files = fs.readdirSync(lp, { recursive: true, withFileTypes: true })
    .filter((d) => d.isFile() && !LOCAL_JUNK.includes(d.name))
    .map((d) => path.relative(lp, path.join(d.parentPath, d.name)).split(path.sep).join('/'))
    .sort();
  const res = { changed: [], created: [], same: [] };
  for (const rel of files) {
    const l = path.join(lp, rel);
    const st = await exists(sftp, `${rp}/${rel}`);
    if (!st) res.created.push(rel);
    else if (st.size !== fs.statSync(l).size) res.changed.push(rel);
    else {
      const remote = await pcall((cb) => sftp.readFile(`${rp}/${rel}`, cb));
      (remote.equals(fs.readFileSync(l)) ? res.same : res.changed).push(rel);
    }
  }
  return res;
}

async function cmdDiff(alias, p, local) {
  const c = conf(alias);
  const rp = remotePath(c, p);
  const lp = local ? localArg(local) : localPath(alias, rp);
  if (!fs.existsSync(lp)) fail(`로컬 파일 없음: ${lp} (먼저 sshq get ${alias} ${p})`);
  const tmp = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'sshq-')), 'remote');
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    if (fs.statSync(lp).isDirectory()) {
      const d = await compareDir(sftp, lp, rp);
      const list = (t, xs) => (xs.length ? `${t} ${xs.length}개:\n${xs.map((x) => `  ${rp}/${x}`).join('\n')}` : `${t} 0개`);
      printOut(`${list('바뀐 파일', d.changed)}\n${list('새 파일', d.created)}\n같은 파일 ${d.same.length}개\n`);
      return;
    }
    await download(sftp, rp, tmp);
  } finally {
    conn.end();
  }
  const r = diffFiles(tmp, lp, `원격:${rp}`, `로컬:${lp}`);
  const crlf = (f) => fs.readFileSync(f).includes('\r\n');
  const eol = r.status !== 0 && !crlf(tmp) && crlf(lp);
  fs.rmSync(path.dirname(tmp), { recursive: true, force: true });
  if (r.status === 0) console.log('차이 없음');
  else printOut(r.stdout);
  if (eol) console.log('주의: 로컬 사본의 줄바꿈이 CRLF로 바뀌었습니다. 원격은 LF입니다. LF로 되돌린 뒤 올리세요.');
}

// diff가 없는 환경(윈도우 PowerShell 등)은 git diff --no-index로 비교하고 머리글을 diff -u처럼 바꾼다
function diffFiles(a, b, la, lb) {
  const r = spawnSync('diff', ['-u', '--label', la, '--label', lb, a, b], { encoding: 'utf8' });
  if (!r.error) return r;
  const g = spawnSync('git', ['diff', '--no-index', '--no-color', '--', a, b], { encoding: 'utf8' });
  if (g.error) fail('diff나 git이 필요합니다.');
  const lines = (g.stdout || '').split('\n');
  const at = lines.findIndex((l) => l.startsWith('@@'));
  const out = at < 0 ? g.stdout : [`--- ${la}`, `+++ ${lb}`, ...lines.slice(at)].join('\n');
  return { status: g.status, stdout: out };
}

// 원격 경로를 홈 기준 보관 폴더 아래 같은 경로로: www/a.php → _sshq_backup/www/a.php
const under = (dir, rp) => path.posix.join(dir, rp.replace(/^\/+/, ''));
const bakBase = (rp) => under(BAK_DIR, rp);

const shown = (p) => (p.startsWith('/') ? p : `~/${p}`);

// 원격 안에서 복사한다 (권한·시각 유지). cp를 못 쓰는 서버(SFTP 전용)는 SFTP로 받아 다시 올린다
async function copyRemote(conn, sftp, from, to) {
  const r = await run(conn, `cp -p -- ${q(from)} ${q(to)}`);
  if (r.code === 0) return;
  const tmp = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'sshq-')), 'c');
  await pcall((cb) => sftp.fastGet(from, tmp, cb));
  await pcall((cb) => sftp.fastPut(tmp, to, cb));
  fs.rmSync(path.dirname(tmp), { recursive: true, force: true });
}

// stamp: 폴더 put 묶음은 같은 시각을 써서 restore --batch로 한 번에 찾는다
async function backup(conn, sftp, rp, tag, stamp = ts()) {
  const bak = `${bakBase(rp)}.bak_${stamp}${tag || ''}`;
  await mkdirp(sftp, path.posix.dirname(bak), 0o700);
  await copyRemote(conn, sftp, rp, bak);
  const a = await exists(sftp, rp);
  const b = await exists(sftp, bak);
  if (!b || b.size !== a.size) throw new Error(`백업 확인 실패: ${bak}`);
  return bak;
}

// 백업(있으면) → 업로드 → 원래 권한 유지 → 크기 확인. 백업 경로를 돌려준다 (새 파일이면 '')
async function putFile(conn, sftp, lp, rp, stamp) {
  const st = await exists(sftp, rp);
  const bak = st ? await backup(conn, sftp, rp, '', stamp) : '';
  if (!st) await mkdirp(sftp, path.posix.dirname(rp));
  await pcall((cb) => sftp.fastPut(lp, rp, cb));
  if (st) await pcall((cb) => sftp.chmod(rp, st.mode & 0o7777, cb));
  const now = await exists(sftp, rp);
  if (!now || now.size !== fs.statSync(lp).size) throw new Error(`업로드 확인 실패: ${rp}`);
  return bak;
}

// 지우지 않고 ~/_sshq_to_delete/<원래 경로>로 옮긴다. 같은 이름이 있으면 뒤에 _<시각>을 붙인다
async function moveToDel(sftp, rp) {
  const st = await exists(sftp, rp);
  let dest = under(DEL_DIR, rp);
  if (await exists(sftp, dest)) dest += `_${ts()}`;
  await mkdirp(sftp, path.posix.dirname(dest), 0o700);
  await pcall((cb) => sftp.rename(rp, dest, cb));
  const moved = await exists(sftp, dest);
  if (!moved || (await exists(sftp, rp)) || moved.size !== st.size) throw new Error(`옮기기 확인 실패: ${rp} → ~/${dest}`);
  return dest;
}

async function cmdPut(alias, p, local) {
  const c = conf(alias, true);
  const rp = remotePath(c, p);
  const lp = local ? localArg(local) : localPath(alias, rp);
  if (!fs.existsSync(lp)) fail(`로컬 파일 없음: ${lp}`);
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    if (!fs.statSync(lp).isDirectory()) {
      const bak = await putFile(conn, sftp, lp, rp);
      logAct(alias, 'put', `${rp}${bak ? ` (백업 ${shown(bak)})` : ' (새 파일)'}`);
      console.log(`업로드: ${lp} → ${rp} (${fs.statSync(lp).size} bytes)`);
      console.log(bak ? `백업: ${shown(bak)}\n되돌리기: sshq restore ${alias} ${p}` : '새 파일 (백업 없음)');
      return;
    }
    // 폴더: 바뀐 파일과 새 파일만 같은 시각(묶음)으로 백업·업로드하고, 묶음 내용을 서버에 적어 둔다
    const d = await compareDir(sftp, lp, rp);
    if (!d.changed.length && !d.created.length) return console.log(`올릴 파일 없음 (같은 파일 ${d.same.length}개)`);
    const stamp = ts();
    const full = (xs) => xs.map((x) => `${rp}/${x}`);
    await mkdirp(sftp, BATCH_DIR, 0o700);
    const manifest = JSON.stringify({ path: rp, updated: full(d.changed), created: full(d.created) }, null, 2);
    await pcall((cb) => sftp.writeFile(`${BATCH_DIR}/${stamp}.json`, manifest, cb));
    for (const rel of [...d.changed, ...d.created]) {
      try {
        await putFile(conn, sftp, path.join(lp, rel), `${rp}/${rel}`, stamp);
      } catch (e) {
        throw new Error(`${e.message}\n여기까지 올린 것 되돌리기: sshq restore ${alias} --batch ${stamp}`);
      }
      logAct(alias, 'put', `${rp}/${rel} (묶음 ${stamp})`);
    }
    console.log(`업로드: ${lp}/ → ${rp}/ (바뀐 파일 ${d.changed.length}개, 새 파일 ${d.created.length}개, 같은 파일 ${d.same.length}개)`);
    console.log(`묶음: ${stamp}\n되돌리기: sshq restore ${alias} --batch ${stamp}`);
  } finally {
    conn.end();
  }
}

async function cmdRestore(alias, p, bakArg) {
  const c = conf(alias, true);
  const rp = remotePath(c, p);
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    let bak = bakArg ? remotePath(c, bakArg) : '';
    if (!bak) {
      // 백업은 원본 수정 시각을 그대로 가져서(cp -p) 파일 시각이 아니라 이름의 시각으로 가장 최근을 고른다
      const dir = path.posix.dirname(bakBase(rp));
      const pre = `${path.posix.basename(rp)}.bak_`;
      const list = (await pcall((cb) => sftp.readdir(dir, cb)).catch(() => []))
        .map((e) => e.filename)
        .filter((n) => n.startsWith(pre) && /^\d{8}_\d{6}$/.test(n.slice(pre.length)))
        .sort()
        .reverse();
      if (!list.length) fail(`백업 없음: ~/${bakBase(rp)}.bak_*`);
      bak = `${dir}/${list[0]}`;
    }
    if (!(await exists(sftp, bak))) fail(`백업 없음: ${bak}`);
    let cur = '';
    if (await exists(sftp, rp)) cur = await backup(conn, sftp, rp, '_before_restore');
    await copyRemote(conn, sftp, bak, rp);
    logAct(alias, 'restore', `${rp} ← ${shown(bak)}`);
    console.log(`되돌림: ${shown(bak)} → ${rp}`);
    if (cur) console.log(`되돌리기 전 상태 백업: ${shown(cur)}`);
  } finally {
    conn.end();
  }
}

// 폴더 put 묶음 되돌리기: 바꾼 파일은 그 묶음의 백업으로, 새로 만든 파일은 ~/_sshq_to_delete로 옮긴다
async function cmdRestoreBatch(alias, stamp) {
  const c = conf(alias, true);
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    if (!stamp) {
      const list = await pcall((cb) => sftp.readdir(BATCH_DIR, cb)).catch(() => []);
      const names = list.map((e) => e.filename.replace(/\.json$/, '')).sort().reverse();
      return console.log(names.length ? `묶음 목록 (최근순):\n${names.map((n) => `  ${n}`).join('\n')}` : '묶음 없음');
    }
    const raw = await pcall((cb) => sftp.readFile(`${BATCH_DIR}/${stamp}.json`, 'utf8', cb)).catch(() => fail(`묶음 없음: ${stamp}`));
    const m = JSON.parse(raw);
    const now = ts();
    let restored = 0;
    let moved = 0;
    for (const rp of m.updated) {
      const bak = `${bakBase(rp)}.bak_${stamp}`;
      if (!(await exists(sftp, bak))) continue; // 묶음 도중 멈춰 아직 안 올린 파일
      if (await exists(sftp, rp)) await backup(conn, sftp, rp, '_before_restore', now);
      await copyRemote(conn, sftp, bak, rp);
      logAct(alias, 'restore', `${rp} ← ${shown(bak)} (묶음 ${stamp})`);
      restored++;
    }
    for (const rp of m.created) {
      if (!(await exists(sftp, rp))) continue;
      const dest = await moveToDel(sftp, rp);
      logAct(alias, 'del', `${rp} → ~/${dest} (묶음 ${stamp} 되돌리기)`);
      moved++;
    }
    console.log(`묶음 ${stamp} 되돌림: ${m.path}/ (백업으로 되돌린 파일 ${restored}개, 새로 만들었던 파일 ${moved}개는 ~/${DEL_DIR}/로 옮김)`);
  } finally {
    conn.end();
  }
}

async function cmdDel(alias, p) {
  const c = conf(alias, true);
  const rp = remotePath(c, p);
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    if (!(await exists(sftp, rp))) fail(`원격 파일 없음: ${rp}`);
    const dest = await moveToDel(sftp, rp);
    logAct(alias, 'del', `${rp} → ~/${dest}`);
    console.log(`옮김: ${rp} → ~/${dest}`);
  } finally {
    conn.end();
  }
}

function cmdLog(alias, n) {
  if (!alias) fail('사용법: sshq log <별칭> [줄수]');
  const f = path.join(LOG, `${alias}.log`);
  if (!fs.existsSync(f)) return console.log(`기록 없음: ${alias}`);
  const lines = fs.readFileSync(f, 'utf8').trimEnd().split('\n');
  console.log(lines.slice(-(Number(n) || 50)).join('\n'));
}

// tar.gz 안의 파일(폴더 제외) 수를 직접 센다. 맥 tar -t는 ._ 파일을 숨겨서 쓰지 않는다
function countTar(file) {
  return new Promise((resolve, reject) => {
    let buf = Buffer.alloc(0);
    let skip = 0;
    let n = 0;
    let done = false;
    const gz = fs.createReadStream(file).pipe(zlib.createGunzip());
    gz.on('data', (d) => {
      buf = buf.length ? Buffer.concat([buf, d]) : d;
      let off = 0;
      while (!done) {
        if (skip) {
          const s = Math.min(skip, buf.length - off);
          off += s;
          skip -= s;
          if (skip) break;
        }
        if (buf.length - off < 512) break;
        const h = buf.subarray(off, off + 512);
        off += 512;
        if (h.every((b) => b === 0)) { done = true; break; }
        const size = h[124] & 0x80 ? Number(h.readBigUInt64BE(128)) : parseInt(h.toString('ascii', 124, 136).replace(/\0.*$/, '').trim() || '0', 8);
        if (!'5LKxgD'.includes(String.fromCharCode(h[156]))) n++;
        skip = Math.ceil(size / 512) * 512;
      }
      buf = buf.subarray(off);
    });
    gz.on('end', () => resolve(n));
    gz.on('error', reject);
  });
}

// 서버 폴더를 tar.gz 하나로 받아 그대로 보관한다 (풀지 않음, clean 대상 아님)
// 폴더를 생략하면 홈 전체, 홈 전체일 때는 sshq 백업·삭제 폴더를 뺀다
async function cmdBackup(alias, p) {
  const c = conf(alias);
  const rp = p ? remotePath(c, p) : '.';
  const ex = rp === '.' ? [BAK_DIR, DEL_DIR] : [];
  const out = path.join(BACKUP, alias, `${alias}_${rp === '.' ? 'home' : rp.replace(/^\/+/, '').replace(/\//g, '_')}_${ts()}.tar.gz`);
  fs.mkdirSync(path.dirname(out), { recursive: true, mode: 0o700 });
  const conn = await connect(alias, c);
  try {
    const sftp = await sftpOf(conn);
    const st = await exists(sftp, rp);
    if (!st || !st.isDirectory()) fail(`원격 폴더 없음: ${rp}`);
    if (!(await shellOk(conn))) {
      // SFTP 전용: 파일마다 받아 로컬에서 tar.gz로 묶는다
      const tmp = path.join(path.dirname(out), `.tmp_${ts()}`);
      fs.mkdirSync(tmp, { recursive: true, mode: 0o700 });
      try {
        const n = await getDirSftp(sftp, rp, tmp, ex);
        const t = spawnSync('tar', ['czf', out, '-C', tmp, '.'], { encoding: 'utf8' });
        if (t.status !== 0) throw new Error(`백업 파일을 만들 수 없습니다: ${t.stderr}`);
        fs.chmodSync(out, 0o600);
        const local = await countTar(out);
        const mb = (fs.statSync(out).size / 1048576).toFixed(1);
        console.log(`백업(SFTP): ${rp === '.' ? '~' : rp} → ${out} (${mb}MB, 파일 ${local}개 / 서버 ${n.ok + n.fail}개)`);
        if (n.fail || local !== n.ok + n.fail) {
          console.error(`서버 파일 수와 다릅니다. 못 받은 파일 ${n.fail}개 (위 '건너뜀' 참고).`);
          process.exitCode = 1;
        }
      } finally {
        fs.rmSync(tmp, { recursive: true, force: true });
      }
      return;
    }
    const tarEx = ex.map((d) => `--exclude=${q(`./${d}`)}`).join(' ');
    const warn = await new Promise((resolve, reject) => {
      conn.exec(`tar czf - ${tarEx} -C ${q(rp)} .`, (err, stream) => {
        if (err) return reject(new Error(`백업을 만들 수 없습니다 (${err.message})`));
        const file = fs.createWriteStream(out, { mode: 0o600 });
        let w = '';
        stream.stderr.on('data', (d) => { w += d; });
        stream.pipe(file);
        file.on('finish', () => resolve(w));
        file.on('error', reject);
      });
    });
    // wc가 없는 서버도 있어 목록을 받아 직접 센다
    const prune = ex.map((d) => `-path ${q(`./${d}`)} -prune -o`).join(' ');
    const r = await run(conn, `cd ${q(rp)} && find . ${prune} ! -type d -print0`);
    const remote = r.out.split('\0').length - 1;
    const local = await countTar(out).catch(() => { throw new Error(`백업 파일이 손상되었습니다: ${out}`); });
    const mb = (fs.statSync(out).size / 1048576).toFixed(1);
    console.log(`백업: ${rp === '.' ? '~' : rp} → ${out} (${mb}MB, 파일 ${local}개 / 서버 ${remote}개)`);
    if (warn) process.stderr.write(warn);
    if (local !== remote) {
      console.error('서버 파일 수와 다릅니다. 위 경고에서 빠진 파일을 확인하세요.');
      process.exitCode = 1;
    }
  } finally {
    conn.end();
  }
}

// 로컬 사본만 지운다 (서버는 건드리지 않음). 범위는 work/<별칭>/ 안
function cmdClean(alias, p) {
  if (!alias) fail('사용법: sshq clean <별칭> [원격경로]');
  const base = path.join(WORK, alias);
  if (path.dirname(base) !== WORK) fail(`잘못된 별칭: ${alias}`);
  const lp = p ? localPath(alias, remotePath(all[alias] || {}, p)) : base;
  if (!fs.existsSync(lp)) return console.log(`지울 사본 없음: ${lp}`);
  const n = fs.statSync(lp).isDirectory()
    ? fs.readdirSync(lp, { recursive: true, withFileTypes: true }).filter((d) => d.isFile()).length
    : 1;
  fs.rmSync(lp, { recursive: true, force: true });
  console.log(`지움: ${lp} (파일 ${n}개)`);
}

// sudo 승인 목록을 고친다. 빼기는 권한을 줄이기만 하므로 승인 규칙을 보지 않는다
function cmdSudoList(listAction, sudoTarget, sudoCommand) {
  if (!sudoTarget || !sudoCommand) fail(`사용법: sshq ${listAction} <별칭|${ALL_SERVERS}> "<명령>"`);
  const forAllServers = sudoTarget === ALL_SERVERS;
  const sudoOwner = forAllServers ? globalSettings : all[sudoTarget];
  if (!sudoOwner) fail(`별칭 없음: ${sudoTarget} (있는 별칭: ${Object.keys(all).join(', ')})`);
  const entry = sudoCommand.trim().split(/\s+/).join(' ');
  if (listAction === 'sudo-allow') {
    const missingRules = missingSudoAllowRules();
    if (missingRules.length) fail(`먼저 ~/.claude/settings.json의 permissions.ask에 추가하세요: ${missingRules.join(', ')}`);
    const pipeSegments = splitPipes(entry);
    if (!pipeSegments || pipeSegments.length > 1 || /["'\\]/.test(entry)) fail('sudo 승인은 명령과 인자만 쓸 수 있습니다. 예: pm2 restart');
    if (entry.split(' ')[0] === 'sudo') fail('sudo를 뺀 명령만 쓰세요. 예: pm2');
    sudoOwner.sudo = [...new Set([...sudoOwner.sudo, entry])];
  } else {
    if (!sudoOwner.sudo.includes(entry)) fail(`승인 목록에 없습니다: ${entry} (승인된 명령: ${sudoOwner.sudo.join(', ') || '없음'})`);
    sudoOwner.sudo = sudoOwner.sudo.filter((approved) => approved !== entry);
  }
  save();
  logAct(sudoTarget, listAction, entry);
  const alsoGlobal = !forAllServers && globalSettings.sudo.length ? ` (모든 서버: ${globalSettings.sudo.join(', ')})` : '';
  console.log(`${forAllServers ? '모든 서버' : sudoTarget} sudo 승인 목록: ${sudoOwner.sudo.join(', ') || '없음'}${alsoGlobal}`);
}

function missingSudoAllowRules() {
  let askRules = [];
  try {
    askRules = JSON.parse(fs.readFileSync(path.join(os.homedir(), '.claude', 'settings.json'), 'utf8')).permissions?.ask || [];
  } catch (e) {
    return SUDO_ALLOW_RULES;
  }
  return SUDO_ALLOW_RULES.filter((rule) => !askRules.includes(rule));
}

function cmdSetNew(cmd, name, a, b) {
  if (cmd === 'new') {
    if (!name) fail('사용법: sshq new <별칭> [root] [설명]');
    if (all[name]) fail(`이미 있는 별칭: ${name}`);
    if (name === GLOBAL_KEY || name === ALL_SERVERS) fail(`별칭으로 쓸 수 없는 이름: ${name}`);
    all[name] = { host: '', port: 22, user: '', password: '', key: '', root: a || '', projects: [], desc: b || '', mode: '', sudo: [] };
  } else {
    if (!name || !a || b === undefined) fail(`사용법: sshq set <별칭> <${EDITABLE.join('|')}> <값>`);
    if (!all[name]) fail(`별칭 없음: ${name} (있는 별칭: ${Object.keys(all).join(', ')})`);
    if (!EDITABLE.includes(a)) fail(`수정할 수 없는 항목: ${a} (가능: ${EDITABLE.join(', ')})`);
    if (a === 'mode' && !MODES.includes(b)) fail('mode는 readonly 또는 ""(빈 값)만 쓸 수 있습니다.');
    const cur = all[name].projects || [];
    let v = b;
    if (a === 'projects') {
      if (/^[+-]/.test(b)) {
        const repo = b.slice(1).trim();
        v = b[0] === '+' ? [...new Set([...cur, repo])] : cur.filter((x) => x !== repo);
      } else {
        v = b.split(',').map((s) => s.trim()).filter(Boolean);
      }
    }
    all[name][a] = v;
  }
  save();
  const { password, key, passphrase, hostkey, ...shown } = all[name];
  const ok = shown.host && shown.user && (password || key);
  console.log(`${name} = ${JSON.stringify(shown)}${ok ? '' : ' (접속정보 미입력)'}`);
}

// ---------- 버전 ----------
// sshq 저장소(DIR)의 git으로 설치된 버전과 원격(origin)의 새 커밋을 비교한다
const gitDir = (...args) => {
  const r = spawnSync('git', ['-C', DIR, ...args], { encoding: 'utf8' });
  return { ok: r.status === 0, out: (r.stdout || '').trimEnd(), err: (r.stderr || '').trim() };
};
function versionState() {
  const f = gitDir('fetch', '-q', 'origin');
  if (!f.ok) fail(`새 버전을 확인할 수 없습니다: ${f.err}`);
  const [ahead, behind] = gitDir('rev-list', '--left-right', '--count', 'HEAD...@{u}').out.split(/\s+/).map(Number);
  return {
    cur: gitDir('log', '-1', '--format=%h %cd %s', '--date=format:%Y-%m-%d').out,
    ahead,
    behind,
    dirty: gitDir('status', '--porcelain', '--untracked-files=no').out,
    news: behind ? gitDir('log', '--format=  %h %s', 'HEAD..@{u}').out : '',
  };
}
function cmdVersion() {
  const v = versionState();
  console.log(`설치된 버전: ${v.cur}`);
  if (v.behind) console.log(`새 버전 ${v.behind}개 (sshq update로 업데이트):\n${v.news}`);
  else console.log('최신 버전입니다.');
  if (v.ahead) console.log(`올리지 않은 로컬 커밋 ${v.ahead}개`);
  if (v.dirty) console.log(`로컬에서 고친 파일:\n${v.dirty}`);
}
function cmdUpdate() {
  const v = versionState();
  if (!v.behind) return console.log(`최신 버전입니다: ${v.cur}`);
  if (v.dirty) fail(`로컬에서 고친 파일이 있어 업데이트를 멈춥니다:\n${v.dirty}`);
  if (v.ahead) fail(`올리지 않은 로컬 커밋 ${v.ahead}개가 있어 업데이트를 멈춥니다.`);
  const p = gitDir('merge', '--ff-only', '@{u}');
  if (!p.ok) fail(`업데이트 실패: ${p.err}`);
  // 지금 실행 중인 node로 다시 설치해 런처의 node가 바뀌지 않게 한다 (npm도 같은 node 폴더의 것을 쓰게 PATH 앞에)
  // 윈도우는 키가 Path일 수 있다
  const key = Object.keys(process.env).find((k) => k.toUpperCase() === 'PATH') || 'PATH';
  const env = { ...process.env, [key]: `${path.dirname(process.execPath)}${path.delimiter}${process.env[key] || ''}` };
  const i = spawnSync(process.execPath, [path.join(DIR, 'install.js')], { cwd: DIR, env, encoding: 'utf8' });
  if (i.status !== 0) fail(`설치 실패:\n${i.stdout}${i.stderr}`);
  console.log(`업데이트 완료: ${v.cur} → ${gitDir('log', '-1', '--format=%h %cd %s', '--date=format:%Y-%m-%d').out}\n${v.news}`);
}

// 인자 없이 실행하면 별칭 목록 (비밀번호·키 제외), 현재 프로젝트를 쓰는 별칭에 * 표시
function cmdList() {
  const git = (cmd) => {
    try {
      return execSync(`git ${cmd}`, { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
    } catch (e) {
      return '';
    }
  };
  const url = git('remote get-url origin');
  const repo = url ? url.replace(/\.git$/, '').split(/[/:]/).pop() : path.basename(git('rev-parse --show-toplevel') || process.cwd());
  console.log(`현재 프로젝트: ${repo}`);
  if (globalSettings.sudo.length) console.log(`모든 서버 sudo: ${globalSettings.sudo.join(', ')}`);
  console.log(['', '별칭', 'host', 'user', '인증', 'root', '모드', 'sudo', '프로젝트', '설명'].join('\t'));
  for (const [k, c] of Object.entries(all)) {
    const mark = repo && (c.projects || []).includes(repo) ? '*' : '';
    const auth = c.key ? '키' : c.password ? '비밀번호' : c.host ? 'agent' : '';
    console.log([mark, k, c.host, c.user, auth, c.root, c.mode, c.sudo.join(','), (c.projects || []).join(','), c.desc].map((v) => (v == null ? '' : v)).join('\t'));
  }
}

async function main() {
  const [a0, a1, a2, a3] = argv;
  if (!a0) return cmdList();
  switch (a0) {
    case 'ls': return cmdLs(a1, a2);
    case 'get': return cmdGet(a1, a2);
    case 'diff': return cmdDiff(a1, a2, a3);
    case 'put': return cmdPut(a1, a2, a3);
    case 'restore': return a2 === '--batch' ? cmdRestoreBatch(a1, a3) : cmdRestore(a1, a2, a3);
    case 'del': return cmdDel(a1, a2);
    case 'log': return cmdLog(a1, a2);
    case 'clean': return cmdClean(a1, a2);
    case 'backup': return cmdBackup(a1, a2);
    case 'version': return cmdVersion();
    case 'update': return cmdUpdate();
    case 'exec': return cmdRun(a1, a2, 'exec');
    case 'sudo': return cmdRun(a1, a2, 'sudo');
    case 'sudo-allow':
    case 'sudo-remove': return cmdSudoList(a0, a1, a2);
    case 'set':
    case 'new': return cmdSetNew(a0, a1, a2, a3);
    default:
      if (CMDS.includes(a0)) fail(USAGE);
      return cmdRun(a0, a1, 'read');
  }
}

main().catch((e) => fail(e.message || e.code || String(e)));
